# HouseOS Supabase Configuration
# Duplicate this file to .env.local and populate with your Supabase project credentials.

# Required: Supabase Project URL and Anon/Publishable Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Optional: Set to 'true' to explicitly connect to hosted Supabase during local development.
# When unset in local development, HouseOS falls back to local Docker Supabase (127.0.0.1:54321).
# In production (e.g., Vercel deployment), hosted Supabase is automatically selected.
USE_REMOTE_SUPABASE=true
